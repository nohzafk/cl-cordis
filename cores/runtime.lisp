;;;; Generated by bend-emit-cl: the runtime every emitted core uses. Do not edit; rebuild.
(eval-when (:compile-toplevel :load-toplevel :execute)
  (when (find-package '#:cl-cordis.runtime) (sb-ext:unlock-package '#:cl-cordis.runtime)))
(defpackage #:cl-cordis.runtime
  (:use #:cl))

(in-package #:cl-cordis.runtime)

(declaim (optimize (speed 3) (safety 1) (debug 0)))

;; :bend-arena when this Lisp can allocate in an arena (see Arena below)
(eval-when (:compile-toplevel :load-toplevel :execute)
  (let ((s (and (find-package "SB-IMPL") (find-symbol "+INTERNAL-FEATURES+" "SB-IMPL"))))
    (when (and s (boundp s) (member :system-tlabs (symbol-value s)))
      (pushnew :bend-arena *features*))))

(deftype bend-nat () '(unsigned-byte 48))
(deftype bend-u32 () '(unsigned-byte 32))

;; Built-in Tuple, Cmp, Word structs
(defstruct (tuple (:constructor make-tuple (fst snd)) (:copier nil))
  (fst nil :read-only t)
  (snd nil :read-only t))

(defstruct (lt (:constructor make-lt ()) (:copier nil)))
(defstruct (eq-cmp (:constructor make-eq ()) (:copier nil)))
(defstruct (gt (:constructor make-gt ()) (:copier nil)))
(deftype bend-cmp () '(or lt eq-cmp gt))
(defparameter +lt+ (make-lt))
(defparameter +eq+ (make-eq))
(defparameter +gt+ (make-gt))
(declaim (inline lt-p eq-p gt-p cmp-new))
(defun eq-p (x) (eq-cmp-p x))
(defun cmp-new (a b)
  (cond ((< a b) +lt+)
        ((= a b) +eq+)
        (t +gt+)))

(defstruct (wnil (:constructor make-wnil ()) (:copier nil)))
(defstruct (wcon (:constructor make-wcon (head tail)) (:copier nil))
  (head nil :read-only t)
  (tail nil :read-only t))
(deftype bend-word () '(or wnil wcon))
(defparameter +wnil+ (make-wnil))

(defun word-to-u32 (w)
  (let ((x 0))
    (declare (type (unsigned-byte 32) x))
    (loop for i of-type fixnum from 0 below 32
          while (wcon-p w)
          do (when (wcon-head w)
               (setf x (logior x (ash 1 i))))
             (setf w (wcon-tail w)))
    x))

(defun u32-to-word (x)
  (declare (type (unsigned-byte 32) x))
  (let ((w +wnil+))
    (loop for i of-type fixnum from 31 downto 0
          do (setf w (make-wcon (logbitp i x) w)))
    w))

(declaim (inline nat-chk nat-in nat-divmod))
(defun nat-chk (n)
  (declare (type integer n))
  (if (> n 281474976710655)
      (error "bend: a Nat past the largest immediate 2^48-1")
      n))

(defun nat-in (n)
  (if (and (integerp n) (>= n 0) (<= n 9007199254740992))
      n
      (error "bend: expected a Nat host number: an integer from 0 to 2^53")))

(defun nat-divmod (a b)
  (declare (type integer a b))
  (if (= b 0)
      (make-tuple 0 a)
      (multiple-value-bind (q r) (truncate a b)
        (make-tuple q r))))

;; A delayed argument (see LAZY in the emitter). val is +unforced+, an object that nothing else
;; holds, until its value is there. fn is the function that computes it, then the thread that
;; runs it, then nil.
;; Closures that hold one delayed argument may be called by different threads of a host, so
;; threads may force one thunk at once. fn runs once: its body may consume a value in place (a
;; reused cell, an array), and a second run would compute from what the first left. A thread
;; claims fn by compare-and-swap and the others wait for val. A run that leaves without a value
;; puts a function that signals in fn, so every later force signals and none waits.
(sb-ext:define-load-time-global +unforced+ (make-symbol "UNFORCED"))
(defstruct (bthunk (:constructor make-bthunk (fn)) (:copier nil))
  (fn nil)
  (val +unforced+))

(defun bthunk-failed ()
  (error "bend: a delayed argument is read after its computation failed"))

(declaim (ftype (function (bthunk) (values t &optional)) bforce-run))
(defun bforce-run (x)
  (let ((me sb-thread:*current-thread*) (waits 0))
    (declare (type fixnum waits))
    (loop
      (let ((f (bthunk-fn x)))
        (if (functionp f)
            (when (eq (sb-ext:compare-and-swap (bthunk-fn x) f me) f)
              (let ((done nil))
                (unwind-protect
                     (let ((v (funcall f)))
                       ;; the compare-and-swap is the store that other threads may read through
                       (sb-ext:compare-and-swap (bthunk-val x) +unforced+ v)
                       (setq done t)
                       (setf (bthunk-fn x) nil)
                       (return v))
                  (unless done (setf (bthunk-fn x) #'bthunk-failed)))))
            (progn
              (sb-thread:barrier (:read))
              (let ((v (bthunk-val x)))
                (unless (eq v +unforced+) (return v)))
              (when (eq f me)
                (error "bend: a delayed argument is read by its own computation"))
              (if (< waits 200)
                  (progn (incf waits) (sb-thread:thread-yield))
                  (sleep 0.0005))))))))

(declaim (inline bforce bpass))
(defun bforce (x)
  (if (bthunk-p x)
      (let ((v (bthunk-val x)))
        (if (eq v +unforced+) (bforce-run x) v))
      x))

;; A variable passed to a lazy parameter: the value, or the thunk, as it is.
;; It exists so the strictness pass can tell this passing from a use.
(defun bpass (x) x)

;; An argument computed before the call for a lazy parameter, because it is
;; cheap and total. It exists so the strictness pass can tell it from a use.
(declaim (inline beager))
(defun beager (x) x)

;; BODY with the float traps that SBCL starts with masked, so F32 operations
;; give IEEE 754's answers (NaN, inf) as bend does (see F32 Traps in the
;; emitter). A public function that can reach F32 work runs under it.
(defmacro ieee-floats (&body body)
  #+sbcl `(sb-int:with-float-traps-masked (:overflow :invalid :divide-by-zero) ,@body)
  #-sbcl `(progn ,@body))

;; F32 comparisons, apart from the U32 ones. Bend compares as IEEE 754 does
;; with its traps off: with a NaN on either side, quiet or signalling, is_ne
;; is true and the other five are false. Under SBCL's default float traps,
;; < <= > >= signal on any NaN and = /= on a signalling one, so each tests
;; both operands for a NaN by their bits first; a test of a constant folds
;; away, and none switches the float traps. Under ieee-floats the plain
;; comparisons would answer so too, but a closure in a public function's
;; result (a List of functions) runs when the host calls it, outside
;; ieee-floats.
(declaim (inline f32-nan-p f32-eq f32-ne f32-lt f32-le f32-gt f32-ge))
(defun f32-nan-p (x)
  (declare (type single-float x))
  #+sbcl (sb-ext:float-nan-p x)
  #-sbcl (/= x x))
(defun f32-eq (a b) (declare (type single-float a b)) (and (not (f32-nan-p a)) (not (f32-nan-p b)) (= a b)))
(defun f32-ne (a b) (declare (type single-float a b)) (not (and (not (f32-nan-p a)) (not (f32-nan-p b)) (= a b))))
(defun f32-lt (a b) (declare (type single-float a b)) (and (not (f32-nan-p a)) (not (f32-nan-p b)) (< a b)))
(defun f32-le (a b) (declare (type single-float a b)) (and (not (f32-nan-p a)) (not (f32-nan-p b)) (<= a b)))
(defun f32-gt (a b) (declare (type single-float a b)) (and (not (f32-nan-p a)) (not (f32-nan-p b)) (> a b)))
(defun f32-ge (a b) (declare (type single-float a b)) (and (not (f32-nan-p a)) (not (f32-nan-p b)) (>= a b)))

(declaim (inline f32-round f32-div f32-bits f32-from-bits))
(defun f32-round (x)
  (coerce x 'single-float))

;; X / Y. SBCL derives (/ X X) as exactly 1 when it knows X's bounds, though
;; 0/0 is a NaN, and folds a division of two constants at compile time, where a
;; zero divisor signals. So the divisor reaches the division through its word:
;; the compiler sees neither the dividend nor a constant there.
(defun f32-div (x y)
  (declare (type single-float x y))
  (/ x #+sbcl (sb-ext:truly-the single-float
                (sb-kernel:%make-lisp-obj (sb-kernel:get-lisp-obj-address y)))
       #-sbcl y))

(defun f32-bits (x)
  (declare (type single-float x))
  #+sbcl (ldb (byte 32 0) (sb-kernel:single-float-bits x))
  #-sbcl (declare (ignore x)) #-sbcl 0)

(defun f32-from-bits (u)
  (declare (type (unsigned-byte 32) u))
  #+sbcl (sb-kernel:make-single-float (if (logbitp 31 u) (- u #x100000000) u))
  #-sbcl (coerce u 'single-float))

;; F32 operations whose CL function gives no NaN outside its domain, where bend
;; gives one: CL's sqrt, log, asin and acos give a complex number there, and
;; expt one for a negative base and a fractional power; rem signals on a zero
;; divisor, and gives no -0 and no x for (rem x inf), as C's fmod does. Each
;; runs under ieee-floats, with its operations' traps masked.
;; X as a NaN: X quieted when it is a NaN, else the default NaN.
(declaim (inline f32-nan f32-sqrt f32-log f32-asin f32-acos f32-pow))
(defun f32-nan (x)
  (declare (type single-float x))
  (+ x (f32-from-bits #x7fc00000)))
(defun f32-sqrt (x)
  (declare (type single-float x))
  (if (< x 0.0f0) (f32-nan x) (sqrt x)))
(defun f32-log (x &optional base)
  (declare (type single-float x))
  (cond ((< x 0.0f0) (f32-nan x))
        ;; in double, as C's log2 and log10 are: in single, log10(2) is 1 ulp off
        (base (coerce (log (coerce x 'double-float) (coerce (the single-float base) 'double-float)) 'single-float))
        (t (log x))))
(defun f32-asin (x)
  (declare (type single-float x))
  (if (<= -1.0f0 x 1.0f0) (asin x) (f32-nan x)))
(defun f32-acos (x)
  (declare (type single-float x))
  (if (<= -1.0f0 x 1.0f0) (acos x) (f32-nan x)))
(defun f32-pow (x y)
  (declare (type single-float x y))
  (cond ((= y 0.0f0) 1.0f0)
        ((= x 1.0f0) 1.0f0)
        ((or (f32-nan-p x) (f32-nan-p y)) (+ x y))
        ;; a float of magnitude 2^24 or more is a whole number; C's pow(-inf, y) is inf or 0
        ((and (< (f32-from-bits #xff800000) x 0.0f0) (< (abs y) 16777216.0f0) (/= y (ftruncate y)))
         (f32-nan x))
        (t (coerce (expt x y) 'single-float))))
(defun f32-mod (x y)
  (declare (type single-float x y))
  #+sbcl
  (cond ((or (f32-nan-p x) (f32-nan-p y)) (+ x y))
        ((or (= y 0.0f0) (sb-ext:float-infinity-p x)) (f32-nan x))
        ((sb-ext:float-infinity-p y) x)
        ;; exact, as fmod is: the remainder of two floats is a float
        (t (let ((r (coerce (rem (rational x) (rational y)) 'single-float)))
             (if (= r 0.0f0) (float-sign x 0.0f0) r))))
  #-sbcl (rem x y))

(defun f32-read-raw (str)
  (declare (type (simple-array character (*)) str))
  (let ((n (length str))
        (i 0))
    (declare (type fixnum n i))
    (flet ((ws-p (ch)
             (let ((c (char-code ch)))
               (or (= c 32) (= c 9) (= c 10) (= c 11) (= c 12) (= c 13))))
           (digit-p (ch) (char<= #\0 ch #\9))
           (sub-eq-ci (start target)
             (and (= (- n start) (length target))
                  (string-equal str target :start1 start))))
      (loop while (and (< i n) (ws-p (schar str i))) do (incf i))
      (when (>= i n) (return-from f32-read-raw (values 0.0f0 nil)))
      (let ((neg nil))
        (cond ((char= (schar str i) #\+) (incf i))
              ((char= (schar str i) #\-) (setf neg t) (incf i)))
        (when (>= i n) (return-from f32-read-raw (values 0.0f0 nil)))
        (cond
          ((or (sub-eq-ci i "inf") (sub-eq-ci i "infinity"))
           (values (f32-from-bits (if neg #xff800000 #x7f800000)) t))
          ((sub-eq-ci i "nan")
           (values (f32-from-bits #x7fc00000) t))
          (t
           (let ((d0 i) (d1 i) (has-dot nil) (f0 0) (f1 0) (has-exp nil) (es "") (e0 0) (e1 0))
             (declare (type fixnum d0 d1 f0 f1 e0 e1))
             (loop while (and (< i n) (digit-p (schar str i))) do (incf i))
             (setf d1 i)
             (when (and (< i n) (char= (schar str i) #\.))
               (setf has-dot t) (incf i) (setf f0 i)
               (loop while (and (< i n) (digit-p (schar str i))) do (incf i))
               (setf f1 i))
             (when (and (= d0 d1) (= f0 f1))
               (return-from f32-read-raw (values 0.0f0 nil)))
             (when (and (< i n) (or (char= (schar str i) #\e) (char= (schar str i) #\E)))
               (setf has-exp t) (incf i)
               (when (< i n)
                 (cond ((char= (schar str i) #\+) (setf es "+") (incf i))
                       ((char= (schar str i) #\-) (setf es "-") (incf i))))
               (setf e0 i)
               (loop while (and (< i n) (digit-p (schar str i))) do (incf i))
               (setf e1 i)
               (when (= e0 e1) (return-from f32-read-raw (values 0.0f0 nil))))
             (when (/= i n) (return-from f32-read-raw (values 0.0f0 nil)))
             (let* ((int-part (if (< d0 d1) (subseq str d0 d1) "0"))
                    (frac-part (if (and has-dot (< f0 f1)) (subseq str f0 f1) "0"))
                    (exp-part (if has-exp (concatenate 'string "f" es (subseq str e0 e1)) "f0"))
                    (norm (concatenate 'string (if neg "-" "") int-part "." frac-part exp-part))
                    (v (handler-case
                           #+sbcl
                           (sb-int:with-float-traps-masked (:overflow :underflow :inexact)
                             (the single-float (read-from-string norm)))
                           #-sbcl
                           (the single-float (read-from-string norm))
                         (floating-point-overflow ()
                           (f32-from-bits (if neg #xff800000 #x7f800000)))
                         (floating-point-underflow ()
                           (if neg -0.0f0 0.0f0)))))
               (values (the single-float v) t)))))))))

(defun f32-show (x)
  (declare (type single-float x))
  #+sbcl
  (cond ((sb-ext:float-nan-p x) (return-from f32-show "nan"))
        ((sb-ext:float-infinity-p x) (return-from f32-show (if (< x 0.0f0) "-inf" "inf"))))
  #-sbcl
  (when (/= x x) (return-from f32-show "nan"))
  (when (= x 0.0f0)
    (return-from f32-show (if (< (float-sign x) 0.0f0) "-0" "0")))
  (let* ((neg (< x 0.0f0))
         (ax (abs x))
         (best nil)
         (dx (coerce ax 'double-float)))
    (loop for p from 0 to 8
          for s of-type simple-string = (format nil "~,v,,,,,'eE" p dx)
          for ep of-type fixnum = (or (position #\e s :test #'char-equal) (length s))
          for sf of-type simple-string = (concatenate 'string (subseq s 0 ep) "f" (subseq s (1+ ep)))
          for parsed = (handler-case
                           (the single-float (read-from-string sf))
                         (error () nil))
          do (when (and parsed (= (the single-float parsed) ax))
               (setf best s)
               (return)))
    (unless best
      (setf best (format nil "~,8,,,,,'eE" dx)))
    (let* ((bstr (the simple-string best))
           (ep (or (position #\e bstr :test #'char-equal) (length bstr)))
           (dot (or (position #\. bstr :end ep) ep))
           (ex (+ (parse-integer bstr :start (1+ ep)) (the fixnum (1- dot))))
           (raw (remove #\. (subseq bstr 0 ep)))
           (digits (let ((trimmed (string-right-trim "0" raw)))
                     (if (= (length trimmed) 0) "0" trimmed)))
           (nd (length digits))
           (p (1- nd)))
      (declare (type fixnum ep dot ex nd p))
      (coerce
       (if (or (>= ex 21) (<= ex -7))
           (if (= nd 1)
               (format nil "~a~ae~a~d" (if neg "-" "") digits (if (>= ex 0) "+" "") ex)
               (format nil "~a~c.~ae~a~d" (if neg "-" "") (schar digits 0) (subseq digits 1)
                       (if (>= ex 0) "+" "") ex))
           (with-output-to-string (out)
             (when neg (write-char #\- out))
             (loop for q of-type fixnum from (max ex 0) downto (min 0 (- ex p))
                   do (when (= q -1) (write-char #\. out))
                      (write-char (if (and (<= q ex) (>= q (- ex p)))
                                      (schar digits (- ex q))
                                      #\0)
                                  out))))
       '(simple-array character (*))))))

;; Zero-copy O(1) String Slice Cursor + ASCII single-char cache
(deftype bend-str () '(simple-array character (*)))

(defstruct (bstr-slice (:constructor make-bstr-slice (str pos len)) (:copier nil))
  (str "" :type bend-str :read-only t)
  (pos 0 :type fixnum :read-only t)
  (len 0 :type fixnum :read-only t))

;; A concatenation: String.append, and SCon onto a long string, build one in
;; O(1). The first read flattens it once, iteratively, and keeps the flat
;; string, dropping the children.
(defstruct (bstr-cat (:constructor make-bstr-cat (left right len)) (:copier nil))
  (left nil)
  (right nil)
  (len 0 :type fixnum)
  (flat nil))

(deftype bend-string-val () '(or bend-str bstr-slice bstr-cat))

(defun bstr-flatten (s)
  (or (bstr-cat-flat s)
      (let ((out #-bend-arena (make-string (bstr-cat-len s) :element-type 'character)
                 ;; s keeps the flat string: for an s on the heap, read in an arena,
                 ;; the flat string goes on the heap too
                 #+bend-arena
                 (if (and (not (eql (sb-vm:thread-current-arena) 0)) (sb-kernel:dynamic-space-obj-p s))
                     (sb-vm:without-arena (make-string (bstr-cat-len s) :element-type 'character))
                     (make-string (bstr-cat-len s) :element-type 'character)))
            (x s)
            (end (bstr-cat-len s))
            (stack nil))
        (declare (type bend-str out) (type fixnum end))
        ;; x fills out up to end. A node with one unflattened child copies the
        ;; other child and goes on into it, so a chain of either direction
        ;; walks without a stack; only a node whose children both need a walk
        ;; pushes one.
        (flet ((leaf (y) (not (and (bstr-cat-p y) (null (bstr-cat-flat y)))))
               ;; bstr-length is defined below; its body, here
               (len (y)
                 (cond ((bstr-slice-p y) (the fixnum (- (bstr-slice-len y) (bstr-slice-pos y))))
                       ((bstr-cat-p y) (bstr-cat-len y))
                       (t (length (the bend-str y)))))
               (put (y at)
                 (declare (type fixnum at))
                 (multiple-value-bind (str start stop)
                     (cond ((bstr-cat-p y)
                            (let ((f (bstr-cat-flat y))) (values f 0 (length (the bend-str f)))))
                           ((bstr-slice-p y)
                            (values (bstr-slice-str y) (bstr-slice-pos y) (bstr-slice-len y)))
                           (t (values y 0 (length (the bend-str y)))))
                   (declare (type bend-str str) (type fixnum start stop))
                   ;; cl: since a package may shadow replace with a public function
                   (cl:replace out str :start1 at :start2 start :end2 stop))))
          (declare (inline leaf len put))
          (loop
            (if (leaf x)
                (progn
                  (put x (- end (the fixnum (len x))))
                  (if stack
                      (let ((e (pop stack))) (setf x (car e) end (cdr e)))
                      (return)))
                (let ((l (bstr-cat-left x))
                      (r (bstr-cat-right x)))
                  (if (or (null l) (null r))
                      ;; another thread flattened x after the test above: x is a leaf now
                      (sb-thread:barrier (:read))
                      (let ((rl (len r)))
                        (declare (type fixnum rl))
                        (cond ((leaf r) (put r (- end rl)) (setf x l end (- end rl)))
                              ((leaf l) (put l (- end (the fixnum (bstr-cat-len x)))) (setf x r))
                              (t (push (cons r end) stack) (setf x l end (- end rl))))))))))
        ;; Threads may flatten s at once. One of them stores its string, and all of them
        ;; return that one. It alone drops the children, and after the string is stored: a
        ;; reader that finds a child gone finds the string.
        (let ((first (sb-ext:compare-and-swap (bstr-cat-flat s) nil out)))
          (cond (first)
                (t (setf (bstr-cat-left s) nil
                         (bstr-cat-right s) nil)
                   out))))))

(declaim (inline bstr-norm))
(defun bstr-norm (s)
  (if (bstr-cat-p s) (bstr-flatten s) s))

(defparameter +ascii-strings+
  (let ((v (make-array 128)))
    (dotimes (i 128 v)
      (setf (svref v i) (make-string 1 :element-type 'character :initial-element (code-char i))))))

;; A string of another representation, copied: out of line, so that a caller of str-in
;; holds the test alone.
(declaim (notinline str-in-copy))
(defun str-in-copy (s)
  (coerce s '(simple-array character (*))))

(declaim (inline bchar bstr-empty-p bstr-head bstr-tail bstr-slice-tail bstr->string bstr-span bstr-store bstr-length str-in))

(defun bchar (c)
  (declare (type fixnum c))
  (if (and (>= c 0) (< c char-code-limit) (or (< c #xd800) (> c #xdfff)))
      (code-char c)
      (code-char #xfffd)))

(defun str-in (s)
  (if (typep s '(simple-array character (*)))
      s
      (str-in-copy s)))

(defun bstr-empty-p (s)
  (cond ((bstr-cat-p s) nil)
        ((bstr-slice-p s) (>= (bstr-slice-pos s) (bstr-slice-len s)))
        (t (= (length (the bend-str s)) 0))))

(defun bstr-head (s)
  ;; Both sides of a cat are non-empty, so its first character is its leftmost
  ;; leaf's: found without flattening the whole cat
  ;; A left child is followed whether or not its cat is flattened: the first character is
  ;; the same. No left child: the cat is flattened, and after the barrier bstr-norm reads
  ;; its string.
  (loop while (bstr-cat-p s)
        do (let ((l (bstr-cat-left s)))
             (if l (setf s l) (progn (sb-thread:barrier (:read)) (return)))))
  (let ((n (bstr-norm s)))
    (cond ((bstr-slice-p n)
           (char-code (schar (bstr-slice-str n) (bstr-slice-pos n))))
          ((> (length (the bend-str n)) 0)
           (char-code (schar (the bend-str n) 0)))
          (t 0))))

(defun bstr-tail (s)
  (setf s (bstr-norm s))
  (if (bstr-slice-p s)
      (let ((next (1+ (bstr-slice-pos s)))
            (len (bstr-slice-len s)))
        (declare (type fixnum next len))
        (if (>= next len)
            ""
            (make-bstr-slice (bstr-slice-str s) next len)))
      (let* ((str (the bend-str s))
             (len (length str)))
        (declare (type fixnum len))
        (if (<= len 1)
            ""
            (make-bstr-slice str 1 len)))))

(defun bstr-slice-tail (str i len)
  (declare (type bend-str str) (type fixnum i len))
  (let ((next (1+ i)))
    (declare (type fixnum next))
    (if (>= next len)
        ""
        (make-bstr-slice str next len))))

(defun bstr->string (s)
  (cond ((bstr-slice-p s)
         (subseq (bstr-slice-str s) (bstr-slice-pos s) (bstr-slice-len s)))
        ((bstr-cat-p s) (bstr-flatten s))
        (t (the bend-str s))))

;; The characters of s as (values str start end) without copying: a slice's own
;; string and bounds, a flat string whole. For reading by index only: str may be
;; a large source, so it must not be stored.
(defun bstr-span (s)
  (let ((n (bstr-norm s)))
    (if (bstr-slice-p n)
        (values (bstr-slice-str n) (bstr-slice-pos n) (bstr-slice-len n))
        (values (the bend-str n) 0 (length (the bend-str n))))))

;; A string stored in a field or a list: a slice under a quarter of its source
;; is copied out, so a stored slice keeps alive at most four times its own
;; length; a longer slice, a flat string or a concatenation is kept as is.
;; 4n < l is written n < ceiling(l/4): four times a fixnum is not a fixnum.
(defun bstr-store (s)
  (if (and (bstr-slice-p s)
           (< (the fixnum (- (bstr-slice-len s) (bstr-slice-pos s)))
              (ash (+ (length (the bend-str (bstr-slice-str s))) 3) -2)))
      (bstr->string s)
      s))

;; Below this many characters, appending copies; at or above, it links.
(defconstant +bstr-link-min+ 64)

(defun bstr-length (s)
  (cond ((bstr-slice-p s) (the fixnum (- (bstr-slice-len s) (bstr-slice-pos s))))
        ((bstr-cat-p s) (bstr-cat-len s))
        (t (length (the bend-str s)))))

(defun bstr-con (c s)
  (declare (type fixnum c))
  ;; The character a slice's source holds in front of it, put in front of it, is the
  ;; slice one longer: a reader that puts back the character it read allocates a
  ;; slice and links nothing.
  (when (bstr-slice-p s)
    (let ((str (bstr-slice-str s)) (pos (bstr-slice-pos s)))
      (declare (type bend-str str) (type fixnum pos))
      (when (and (> pos 0) (char= (schar str (the fixnum (1- pos))) (bchar c)))
        (return-from bstr-con (make-bstr-slice str (the fixnum (1- pos)) (bstr-slice-len s)))))
    (setf s (bstr-store s)))
  (when (>= (the fixnum (bstr-length s)) +bstr-link-min+)
    (when (>= (the fixnum (bstr-length s)) (1- array-total-size-limit))
      (error "bend: a String of ~d characters, more than this Lisp can allocate" (1+ (bstr-length s))))
    (return-from bstr-con
      (make-bstr-cat (if (< -1 c 128) (svref +ascii-strings+ c) (cl:string (bchar c))) s (the fixnum (1+ (the fixnum (bstr-length s)))))))
  (let ((str (bstr->string s)))
    (declare (type bend-str str))
    (if (= (length str) 0)
        (if (and (>= c 0) (< c 128))
            (the bend-str (svref +ascii-strings+ c))
            (make-string 1 :element-type 'character :initial-element (bchar c)))
        (let* ((len (length str))
               (out (make-string (the fixnum (1+ len)) :element-type 'character)))
          (declare (type fixnum len) (type bend-str out))
          (setf (schar out 0) (bchar c))
          (dotimes (i len out)
            (setf (schar out (the fixnum (1+ i))) (schar str i)))))))

(defun bstr-append (a b)
  (let ((la (bstr-length a))
        (lb (bstr-length b)))
    (declare (type fixnum la lb))
    (cond ((= la 0) (return-from bstr-append b))
          ((= lb 0) (return-from bstr-append a))
          ((>= (+ la lb) array-total-size-limit)
           ;; a rope's length is a fixnum, and its flat string an array
           (error "bend: a String of ~d characters, more than this Lisp can allocate" (+ la lb)))
          ((>= (+ la lb) +bstr-link-min+)
           (return-from bstr-append (make-bstr-cat a b (+ la lb))))))
  (let ((sa (bstr->string a))
        (sb (bstr->string b)))
    (declare (type bend-str sa sb))
    (let ((la (length sa))
          (lb (length sb)))
      (declare (type fixnum la lb))
      (cond ((= la 0) sb)
            ((= lb 0) sa)
            ((= lb 1)
             (let ((out (make-string (the fixnum (1+ la)) :element-type 'character)))
               (declare (type bend-str out))
               (dotimes (i la)
                 (setf (schar out i) (schar sa i)))
               (setf (schar out la) (schar sb 0))
               out))
            (t (let ((out (make-string (the fixnum (+ la lb)) :element-type 'character)))
                 (declare (type bend-str out))
                 (dotimes (i la)
                   (setf (schar out i) (schar sa i)))
                 (dotimes (j lb out)
                   (setf (schar out (the fixnum (+ la j))) (schar sb j)))))))))

;; A loop that builds a string by putting characters in front of it (see
;; toBuilder, pass/loops.ts) keeps them in the back of a buffer, bb from bp on, and joins the
;; buffer to the string it started from when it returns. The buffer starts
;; empty, so a call that puts no character allocates none; the string it
;; started from is joined through bstr-store, as bstr-con would have kept it.
(declaim (inline bsb-con))
(defun bsb-con (bb bp c)
  (declare (type bend-str bb) (type fixnum bp c))
  (when (= bp 0)
    (let* ((n (length bb))
           (m (max 16 (* 2 n)))
           (nb (make-string m :element-type 'character)))
      (declare (type fixnum n m) (type bend-str nb))
      (cl:replace nb bb :start1 (- m n))
      (setf bb nb bp (- m n))))
  (decf bp)
  (setf (schar bb bp) (bchar c))
  (values bb bp))

(defun bsb-done (bb bp suffix)
  (declare (type bend-str bb) (type fixnum bp))
  (if (= bp (length bb)) suffix (bstr-append (subseq bb bp) (bstr-store suffix))))

(defun bstr-eq (a b)
  (string= (bstr->string a) (bstr->string b)))

(defun bstr-contains (s p)
  (not (null (search (bstr->string p) (bstr->string s)))))

;; Array helpers
;; 2^d slots of one word each: a depth whose slots pass array-total-size-limit or
;; whose bytes pass the whole dynamic space signals before anything is allocated.
;; d is compared first, so a huge d never builds 2^d itself.
;; An Array is a simple-vector everywhere (its declared type in every ftype); new and set are inline
;; and say so, so a write is an indexed store and no call.
(declaim (inline array-new))
(defun array-new (d v)
  (declare (type (integer 0 #.most-positive-fixnum) d))
  (when (or (>= d (integer-length array-total-size-limit))
            (>= (ash 1 d) array-total-size-limit)
            (> (* (ash 1 d) sb-vm:n-word-bytes) (sb-ext:dynamic-space-size)))
    (error "bend: Array.new of depth ~d asks for 2^~d slots, more than this Lisp can allocate (~d bytes of dynamic space)"
           d d (sb-ext:dynamic-space-size)))
  (make-array (the (integer 1 (#.array-total-size-limit)) (ash 1 d)) :initial-element v))

(defun array-node (a b)
  (concatenate 'vector a b))

(declaim (inline array-set))
(defun array-set (a i v)
  (declare (type simple-vector a) (type (integer 0 #.most-positive-fixnum) i))
  (setf (svref a (logand i (1- (length a)))) v)
  a)

(defun array-get (a i)
  (make-tuple a (aref a (logand i (1- (length a))))))

(defun array-swap (a i v)
  (let* ((idx (logand i (1- (length a))))
         (old (aref a idx)))
    (setf (aref a idx) v)
    (make-tuple a old)))

;; array-get and array-swap on an array whose element type the emitter knows:
;; the element read is declared that type
(defmacro array-get-as (type a i)
  (let ((av (gensym)) (iv (gensym)))
    `(let* ((,av ,a) (,iv ,i))
       (make-tuple ,av (the ,type (aref ,av (logand ,iv (1- (length ,av)))))))))

(defmacro array-swap-as (type a i v)
  (let ((av (gensym)) (iv (gensym)) (vv (gensym)) (xv (gensym)) (ov (gensym)))
    `(let* ((,av ,a) (,iv ,i) (,vv ,v)
            (,xv (logand ,iv (1- (length ,av))))
            (,ov (the ,type (aref ,av ,xv))))
       (setf (aref ,av ,xv) ,vv)
       (make-tuple ,av ,ov))))

;; ---- Arena: a public function emitted with --arena runs in an arena ----
;; Everything the call allocates goes into a block of memory that the collector
;; does not manage and that the next call uses again; the result is copied to
;; the heap first. *use-arena* nil runs the same functions on the heap.
(defparameter *use-arena* t)
;; The bytes of an arena's first block, kept between calls; the bytes of each
;; further block, freed after the call; and how many further blocks a call may
;; take. A call that needs more than size + growth * extensions ends the Lisp
;; process: SBCL cannot unwind from a full arena on every platform.
(defparameter *arena-size* (* 64 1024 1024))
(defparameter *arena-growth* (* 256 1024 1024))
(defparameter *arena-extensions* 255)
;; When true, every arena call collects the heap and fails if a heap object
;; still points into its arena before the arena is emptied. Slow; for tests.
(defparameter *arena-check* nil)

#-bend-arena
(progn
  (declaim (inline arena-idle-p))
  (defun arena-idle-p () nil)
  (defun arena-call (fn) (funcall (the function fn)))
  (defun arena-reclaim () 0))

#+bend-arena
(progn
(sb-ext:defglobal **arena-pool** nil)
(sb-ext:defglobal **arena-retired** nil)

(declaim (inline arena-idle-p arena-obj-p))
;; True when this thread may enter an arena: none is current.
(defun arena-idle-p ()
  (and *use-arena* (eql (sb-vm:thread-current-arena) 0)))

;; True for an object in memory that is not the collected heap. x is no
;; number, character or symbol.
(defun arena-obj-p (x)
  (not (sb-kernel:dynamic-space-obj-p x)))

;; A string of the result as a flat string on the heap.
(defun arena-out-string (x)
  (cond ((bstr-slice-p x)
         (subseq (bstr-slice-str x) (bstr-slice-pos x) (bstr-slice-len x)))
        ((bstr-cat-p x)
         (let ((f (bstr-cat-flat x)))
           (cond ((null f) (bstr-flatten x))
                 ((arena-obj-p f) (copy-seq f))
                 (t f))))
        ((arena-obj-p x) (copy-seq x))
        (t x)))

;; The result of a call that ran in an arena, with every part of it that lies
;; in the arena copied to the heap. A part on the heap (an argument, a
;; constant) stays as it is, with all it holds. A part reached twice is copied
;; once, and both references get that copy: a value used twice is one object,
;; and copying it per reference would grow the result exponentially. The copy
;; keeps its own stack of the copies whose parts are still to do, so a deep
;; result does not use the control stack: each entry is a copy and, for a
;; list, the last cons of the run copied with it.
(defun arena-out (x)
  (let ((todo (make-array 64)) (n 0) (seen (make-hash-table :test 'eq)))
    (declare (type simple-vector todo) (type fixnum n))
    (labels ((queue (c last)
               (when (= n (length todo))
                 (let ((bigger (make-array (* 2 n))))
                   (cl:replace bigger todo)
                   (setf todo bigger)))
               (setf (svref todo n) c
                     (svref todo (1+ n)) last)
               (incf n 2)
               c)
             (out (v)
               (cond ((or (typep v 'fixnum) (symbolp v) (characterp v) (typep v 'single-float)) v)
                     ((and (stringp v) (not (arena-obj-p v))) v)
                     ((gethash v seen))
                     ((or (stringp v) (bstr-slice-p v) (bstr-cat-p v))
                      (setf (gethash v seen) (arena-out-string v)))
                     ((not (arena-obj-p v)) v)
                     ((consp v)
                      (let* ((head (cons (car v) nil)) (tail head) (r (cdr v)))
                        (setf (gethash v seen) head)
                        (loop while (and (consp r) (arena-obj-p r) (not (gethash r seen)))
                              do (let ((c (cons (car r) nil)))
                                   (setf (gethash r seen) c
                                         (cdr tail) c
                                         tail c
                                         r (cdr r))))
                        (setf (cdr tail) (if (consp r) (or (gethash r seen) r) r))
                        (queue head tail)))
                     ((bthunk-p v) (error "bend arena: a delayed value in a result"))
                     ((sb-kernel:%instancep v)
                      (queue (setf (gethash v seen) (copy-structure v)) nil))
                     ((simple-vector-p v)
                      (queue (setf (gethash v seen) (copy-seq v)) nil))
                     ((functionp v) (error "bend arena: a function in a result"))
                     (t (error "bend arena: a ~a in a result" (type-of v))))))
      (let ((root (out x)))
        (loop while (> n 0)
              do (let ((c (svref todo (- n 2)))
                       (last (svref todo (- n 1))))
                   (decf n 2)
                   (setf (svref todo n) nil
                         (svref todo (1+ n)) nil)
                   (cond ((consp c)
                          (loop for r = c then (cdr r)
                                do (setf (car r) (out (car r)))
                                until (eq r last)))
                         ((simple-vector-p c)
                          (dotimes (i (length c)) (setf (svref c i) (out (svref c i)))))
                         (t
                          (sb-kernel:do-instance-tagged-slot (i c)
                            (setf (sb-kernel:%instance-ref c i) (out (sb-kernel:%instance-ref c i))))))))
        root))))

;; Run fn in an arena and hand back its result on the heap. The arena is
;; emptied and kept for the next call, of any thread. When fn does not return,
;; its arena is set aside as it is: a condition signalled in an arena lies in
;; it, and so does whatever a handler or the debugger made while the call was
;; signalling, since they run inside the call. With an arena already current,
;; or *use-arena* nil, fn runs as it is.
(defun arena-call (fn)
  (declare (type function fn))
  (if (not (arena-idle-p))
      (funcall fn)
      (let ((a nil) (done nil))
        (unwind-protect
             (progn
               (sb-sys:without-interrupts
                 (setq a (or (sb-ext:atomic-pop **arena-pool**)
                             (sb-vm:new-arena *arena-size* *arena-growth* *arena-extensions*))))
               (let ((r (arena-out (sb-vm:with-arena (a) (funcall fn)))))
                 (when *arena-check*
                   (sb-ext:gc :full t)
                   (let ((k (length (sb-vm:c-find-heap->arena a))))
                     (when (> k 0)
                       (error "bend arena: ~d heap object~:p point into the arena after a call" k))))
                 (setq done t)
                 r))
          (sb-sys:without-interrupts
            (when a
              (if done
                  (progn (sb-vm:rewind-arena a)
                         (sb-ext:atomic-push a **arena-pool**))
                  (sb-ext:atomic-push a **arena-retired**))))))))

;; Free the arenas set aside by calls that did not return, and say how many.
;; For the host to call once it holds nothing that such a call signalled and
;; nothing a handler or the debugger made during it: those lie in the arena.
(defun arena-reclaim ()
  (let ((k 0))
    (declare (type fixnum k))
    (loop for a = (sb-ext:atomic-pop **arena-retired**)
          while a
          do (sb-vm:destroy-arena a)
             (incf k))
    k)))

;; A function that puts characters and strings in front of a call to itself
;; (see the Forward String Pass in the emitter) writes them in order into a
;; buffer, fb below fp, and joins the buffer in front of the string the last
;; round returns. The buffer starts empty, so a call that writes nothing
;; allocates nothing and returns that string as it is; joined, the string goes
;; through bstr-store, as bsb-done does.
(declaim (inline bfwd-grow bfwd-con))
(defun bfwd-grow (fb fp n)
  (declare (type bend-str fb) (type fixnum fp n))
  (if (<= (the fixnum (+ fp n)) (length fb))
      fb
      (let ((nb (make-string (max 16 (* 2 (length fb)) (the fixnum (+ fp n))) :element-type 'character)))
        (declare (type bend-str nb))
        (cl:replace nb fb :end2 fp)
        nb)))

(defun bfwd-con (fb fp c)
  (declare (type bend-str fb) (type fixnum fp c))
  (let ((fb (bfwd-grow fb fp 1)))
    (declare (type bend-str fb))
    (setf (schar fb fp) (bchar c))
    (values fb (the fixnum (1+ fp)))))

(defun bfwd-append (fb fp s)
  (declare (type bend-str fb) (type fixnum fp))
  (multiple-value-bind (str start end) (bstr-span s)
    (declare (type bend-str str) (type fixnum start end))
    (let* ((n (- end start))
           (fb (bfwd-grow fb fp n)))
      (declare (type fixnum n) (type bend-str fb))
      (cl:replace fb str :start1 fp :start2 start :end2 end)
      (values fb (the fixnum (+ fp n))))))

(defun bfwd-done (fb fp s)
  (declare (type bend-str fb) (type fixnum fp))
  (if (= fp 0) s (bstr-append (subseq fb 0 fp) (bstr-store s))))

(eval-when (:load-toplevel :execute)
  (do-symbols (s *package*)
    (when (and (eq (symbol-package s) *package*)
               (not (eq s '+unforced+))
               (or (fboundp s) (boundp s) (find-class s nil)
                   ;; a DEFTYPE name; VALID-TYPE-SPECIFIER-P would have the compilation unit
                   ;; report every other symbol as an undefined type
                   (sb-int:info :type :kind s)))
      (export s *package*)))
  (sb-ext:lock-package *package*))
